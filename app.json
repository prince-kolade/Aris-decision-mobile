{
  "expo": {
    "name": "Ari's Decision",
    "slug": "ari-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ari-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.kolly.arismobile",
      "backgroundColor": "#09090B",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#09090B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "kolly01",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfb0029d-d57f-4e4f-b12c-014b79fdacd7"
      }
    }
  }
}
